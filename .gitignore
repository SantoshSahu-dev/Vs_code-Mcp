# ==============================================================================
# Code Bridge MCP — Git Ignore Rules
# Strictly prevents committing private credentials, environment configurations,
# local workspace state, generated binaries, and temporary runtime files.
# ==============================================================================

# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Compiled & Bundled Outputs
dist/
vscode-extension/out/
mcpb-build/
build/

# Packaged Release Artifacts (build locally with npm run package:*)
*.vsix
*.mcpb
*.tgz
*.tar.gz
*.zip

# Environment & Private Configuration Files
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist

# Private Keys, Certificates & Credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
credentials.json
secrets.json
secrets.yml
secrets.yaml

# Local Runtime State & Approvals
.code-bridge/
logs/
*.log

# SQLite Database & Journal Files
*.db
*.db-journal
*.db-wal
*.db-shm

# Local Backups, Dumps & Test Scratch Files
backups/
*.bak
*.tmp
child-env.json
mcp-connection-test.txt
coverage/
.nyc_output/

# Editor & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode-test/
*.sublime-project
*.sublime-workspace
.idea/
