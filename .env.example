# ==============================================================================
# Code Bridge MCP Configuration Template
# Copy this file to .env and customize for your local environment:
#   Windows:  Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# NEVER commit your actual .env file or real secrets to version control.
# Every user must configure their own independent Code Bridge instance.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE WORKSPACE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Absolute path to the local project directory Code Bridge is authorized to access.
# Code Bridge strictly rejects all path traversal and paths outside this directory.
#
# Windows example:
#   CODE_BRIDGE_WORKSPACE=C:\Users\username\Projects\my-app
# Linux / macOS example:
#   CODE_BRIDGE_WORKSPACE=/home/username/projects/my-app
CODE_BRIDGE_WORKSPACE=C:\path\to\your\project

# High-entropy shared authentication token (minimum 32 characters, high randomness).
# Used to authenticate MCP clients and the VS Code extension over loopback.
# Generate a secure token in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Or in Node.js / bash:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODE_BRIDGE_TOKEN=replace-with-at-least-32-random-characters-do-not-use-defaults

# ------------------------------------------------------------------------------
# 2. NETWORK & PORT SETTINGS (Optional)
# ------------------------------------------------------------------------------
# Local TCP port for the Code Bridge MCP server (Streamable HTTP / REST API).
# Defaults to 3333. Always binds strictly to 127.0.0.1.
PORT=3333

# Local TCP port for the companion VS Code extension listener.
# Defaults to 3334. Always binds strictly to 127.0.0.1.
# CRITICAL: This port is for local VS Code communication only. NEVER expose via tunnel!
CODE_BRIDGE_EDITOR_PORT=3334

# Comma-separated list of additional external hostnames allowed in the HTTP Host header.
# Loopback addresses (127.0.0.1, localhost, [::1]) are always permitted.
# When using Cloudflare Tunnels, specify your tunnel hostname here.
# Example:
#   CODE_BRIDGE_ALLOWED_HOSTS=trycloudflare.com,code-bridge.example.com
CODE_BRIDGE_ALLOWED_HOSTS=

# ------------------------------------------------------------------------------
# 3. SAFETY & APPROVAL POLICIES
# ------------------------------------------------------------------------------
# Automatic write approval is permanently disabled by security design.
# Every mutation (write_file, delete_file, run_project_command) requires an explicit
# human decision in your terminal via `npm run approve`.
# Leave as false or omit. Any attempt to set this to true will abort startup.
CODE_BRIDGE_AUTO_APPROVE_WRITES=false

# Set to true to enforce read-only safe mode. All mutating tools (write_file, delete_file,
# run_project_command) will be blocked immediately without creating pending approval requests.
# Recommended during initial remote testing.
CODE_BRIDGE_BLOCK_REMOTE_MUTATIONS=false

# By default, files inside generated directories (node_modules, dist) are hidden from
# list_files, read_file, and search_code. Set to true if you explicitly want the AI to read them.
CODE_BRIDGE_ALLOW_READ_GENERATED=false

# ------------------------------------------------------------------------------
# 4. STORAGE & AUDIT LOGS (Optional)
# ------------------------------------------------------------------------------
# Directory where approval state records and encrypted OAuth database are stored.
# Defaults to ~/.code-bridge (isolated OUTSIDE your workspace root).
# CODE_BRIDGE_STATE_DIR=C:\Users\username\.code-bridge

# File path for operation audit logs (JSON Lines format).
# Only operation metadata is recorded; secrets and file contents are never logged.
# Defaults to logs/audit.jsonl.
CODE_BRIDGE_AUDIT_LOG=logs/audit.jsonl

# ------------------------------------------------------------------------------
# 5. OAUTH 2.1 & WEB AI INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Custom path for encrypted SQLite OAuth persistence database.
# Defaults to <stateDir>/oauth.db.
# CODE_BRIDGE_OAUTH_DB=

# Optional dedicated AES-256 encryption key for the OAuth database.
# Defaults to CODE_BRIDGE_TOKEN if omitted.
# CODE_BRIDGE_OAUTH_KEY=

# Pre-configured confidential OAuth client credentials (e.g. for Gemini Custom Apps).
# Automatically generated and configured by running: npm run oauth:generate
# OAUTH_CLIENT_ID=cb_client_your_client_id
# OAUTH_CLIENT_SECRET=cb_sec_your_client_secret
# OAUTH_ALLOWED_REDIRECT_URIS=https://vertexaisearch.cloud.google.com/oauth-redirect,https://claude.ai/api/mcp/auth_callback
